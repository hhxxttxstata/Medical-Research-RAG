# ─── 构建上下文绝不包含的内容 ───

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.yml
Dockerfile.backend
Dockerfile.backend
Dockerfile.frontend
Dockerfile.nextjs

# 运行时数据（volume 挂载，不进入镜像）
logs/
chroma_db/
chroma_db_eval/
data/diagnosis_uploads/

# 前端 node_modules（体积大，镜像内自己安装）
frontend/node_modules/
frontend/.next/

# 评估与报告
evaluation_report.json

# 训练代码（非部署相关）
teacher/

# 训练/模型权重（体积大，生产用 volume 挂载）
models/*.pth
models/*.pt
models/*.onnx

# 部署脚本（不进入镜像）
*.bat
*.ps1

# 记忆文件
MEMORY.md

# API 密钥（运行时通过 docker-compose env_file 注入）
.env
