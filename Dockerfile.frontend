# ═══════════════════════════════════════════════════════
#  Dockerfile — 前端 Gradio 页面
# ═══════════════════════════════════════════════════════
# 构建:  docker build -f Dockerfile.frontend -t rag-frontend .
# 运行:  docker run --rm -p 7860:7860 -e API_BASE_URL=http://host.docker.internal:8000 rag-frontend
# ═══════════════════════════════════════════════════════

FROM python:3.10-slim

LABEL description="RAG 知识库问答系统 — 前端 Gradio 页面"
LABEL version="2.0.0"

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# ── 配置国内镜像源（加速下载） ──────────────────────
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# ── 安装依赖（纯 Gradio 应用，极轻量） ──────────────
COPY requirements-frontend.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-frontend.txt && \
    rm -rf /root/.cache

# ── 只复制前端需要的文件 ──────────────────────────
COPY gradio_app.py .

# ── 端口 ──────────────────────────────────────────
EXPOSE 7860

# ── 健康检查 ──────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:7860', timeout=5)"

# ── 启动 ──────────────────────────────────────────
CMD ["sh", "-c", "python gradio_app.py"]
