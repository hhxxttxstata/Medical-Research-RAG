# RAG system configuration
# 复制为 .env 并填入自己的密钥：cp .env.example .env

# ── 主 LLM（DeepSeek） ─────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Embedding（默认 intfloat/multilingual-e5-base） ────
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# HuggingFace 下载加速镜像（可选）
HF_TOKEN=hf-your-hf-token
HF_ENDPOINT=https://hf-mirror.com

# ── Redis（docker-compose 内网地址） ───────────────────
REDIS_URL=redis://redis:6379/0

# ── CTPA 诊断模型权重（可选） ──────────────────────────
PE_MODEL_PATH=models/best.pth

# ── Query Rewriting 专用模型（可选，SiliconFlow 等兼容 API） ──
REWRITE_API_KEY=sk-your-rewrite-api-key
REWRITE_BASE_URL=https://your-compatible-api.example.com/v1
REWRITE_MODEL=your-rewrite-model-name

# ── API 访问认证（可选，未配置则免认证） ────────────────
# API_KEY=your-service-api-key
