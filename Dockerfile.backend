# ═══════════════════════════════════════════════════════
#  Dockerfile — 后端 FastAPI 服务
# ═══════════════════════════════════════════════════════
FROM python:3.10-slim

LABEL description="肺栓塞科研文献 RAG 问答系统 — 后端 API"
LABEL version="2.0.0"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# ── Debian 国内镜像源 ──────────────────────────
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources

# ── 系统依赖 ──────────────────────────────────
# 不装 build-essential：全部依赖均有 manylinux 官方 wheel，无需编译；
# 且 build-essential 会拉入完整 perl/linux-libc-dev（trivy 扫出 10 个
# CRITICAL，且上游均无修复版本）。基线镜像自带的 perl-base 3 个无解
# CRITICAL 见 .trivyignore（Debian 必需包，应用不执行 perl）。

# ── pip 国内镜像源 ─────────────────────────────
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# ── Python 依赖（与 CI 测试共用 requirements.txt 唯一清单）───────
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ── 源码 ──────────────────────────────────────
COPY . .
RUN mkdir -p /app/data /app/logs

EXPOSE 8000

CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${API_PORT:-8000} --log-level info"]
